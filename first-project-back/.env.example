# 将这些变量配置到 IDEA Run Configuration 或启动终端中。
DB_URL=jdbc:postgresql://127.0.0.1:5432/devnest
POSTGRES_DB=devnest
DB_USERNAME=devnest
DB_PASSWORD=请替换为数据库密码

# Docker PostgreSQL 初始化管理员；应用使用上面的独立普通账号。
POSTGRES_ADMIN_PASSWORD=请替换为独立的PostgreSQL管理员密码
# 后端启动自动建表；数据导入见 docs/POSTGRESQL_SETUP.md。

# 至少 32 字节随机内容的 Base64。生产环境必须替换。
JWT_SECRET_BASE64=请替换为Base64密钥
JWT_ISSUER=devnest-api
JWT_ACCESS_TOKEN_TTL=PT12H

# 账号安全：邀请链接 48 小时有效；管理员重置的随机临时密码 30 分钟有效。
INVITATION_TOKEN_TTL=PT48H
TEMPORARY_PASSWORD_TTL=PT30M
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCK_DURATION=PT15M
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=PT1M
SAVE_RATE_LIMIT_ATTEMPTS=12
SAVE_RATE_LIMIT_WINDOW=PT10S

# 默认允许空库启动后手动导入数据。导入已有账号时保持邮箱和密码为空。
# 完全从零使用时可填写初始管理员，密码要求 16-72 位；首次登录改密后删除这两个值。
BOOTSTRAP_ADMIN_REQUIRED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 多个来源用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SERVER_PORT=8080

# 阿里云 OSS：仅后端使用；填入后改为 true。不要放入前端 VITE_* 变量。
OSS_ENABLED=false
# 与 Bucket 地域一致。仅当后端位于同地域阿里云网络时才改用 -internal Endpoint。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=请替换为Bucket名称
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 使用临时 STS 凭证时填写；普通 RAM AccessKey 留空。
OSS_SECURITY_TOKEN=
OSS_IMAGE_PREFIX=markdown/images
# 对象键按此时区生成 yyyy/MM/dd 日期目录。
OSS_IMAGE_TIME_ZONE=Asia/Shanghai
# 仅当 Bucket 已明确设置为公共读时开启；公共写始终禁止。
OSS_PUBLIC_READ=false
